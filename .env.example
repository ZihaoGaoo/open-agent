# 复制为 .env 并按需修改。docker-compose 会读取部分变量。

# 进程角色: web | worker
ROLE=web
PORT=8000

# 运行环境: dev | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# PostgreSQL（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://openagent:openagent@localhost:5432/openagent

# 默认 LLM Provider（Claude）
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-opus-4-8

# 凭据库加密用的 Fernet key（base64, 32 bytes）。生成：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# 控制台用户 JWT 签名密钥
JWT_SECRET=dev-insecure-change-me

# 可选：Redis（多实例时用于 SSE 扇出 / 多 agent pub-sub / 限流）
# REDIS_URL=redis://localhost:6379/0
